# POSTGRES
POSTGRES_DB=csv_importer
POSTGRES_USER=csv
POSTGRES_PW=csv
POSTGRES_PORT=54321
POSTGRES_HOST=127.0.0.1
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PW}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# REDIS
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# API
API_HOST=localhost
API_PORT=3010
API_URL=http://${API_HOST}:${API_PORT}

# STORAGE
STORAGE_DRIVER=local # local | s3
STORAGE_ROOT=FILES_PATH
SIGNING_KEY=GENERATE_YOUR_OWN_KEY ## Hint: openssl rand -hex 32
BASE_URL=${API_URL}/files
